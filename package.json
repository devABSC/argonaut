{
  "name": "argonaut",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "test": "node --experimental-strip-types --no-warnings tests/rbac.test.ts && node --experimental-strip-types --no-warnings tests/access.test.ts && node --experimental-strip-types --no-warnings tests/sla.test.ts && node --experimental-strip-types --no-warnings tests/password.test.ts && node --experimental-strip-types --no-warnings tests/strength.test.ts",
    "ship": "bash scripts/ship.sh",
    "verify:live": "bash scripts/verify-live.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@prisma/client": "^6.19.3",
    "@types/pdfkit": "^0.17.6",
    "bcryptjs": "^3.0.3",
    "mammoth": "^1.12.0",
    "next": "16.2.12",
    "nodemailer": "^9.0.3",
    "pdfjs-dist": "^6.2.108",
    "pdfkit": "^0.19.1",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  }
}
