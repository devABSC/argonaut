// Argonaut — Prisma schema. Postgres on Supabase (DATABASE_URL, pooled).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Account lifecycle. Self-registration creates PENDING; an HR approver or
/// Super User moves it to ACTIVE. Only ACTIVE accounts can hold a session.
enum AccountStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

model User {
  id                 String        @id @default(cuid())
  email              String        @unique
  name               String
  passwordHash       String // bcrypt
  roleId             String
  role               Role          @relation(fields: [roleId], references: [id])
  status             AccountStatus @default(PENDING)
  /// Which company this account belongs to; matches Employee.company codes.
  company            String?
  /// Set on accounts whose password was not chosen by the person using them.
  /// They are held at the change-password screen until they pick their own.
  mustChangePassword Boolean       @default(false)
  passwordChangedAt  DateTime?
  createdAt          DateTime      @default(now())

  /// Audit of the last change made to this account from Settings -> Users.
  updatedAt   DateTime @default(now()) @updatedAt
  updatedById String?
  updatedBy   User?    @relation("UserEdits", fields: [updatedById], references: [id], onDelete: SetNull)
  edits       User[]   @relation("UserEdits")

  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?     @relation("Approvals", fields: [approvedById], references: [id], onDelete: SetNull)
  approvals    User[]    @relation("Approvals")

  // Reporting line: an Employee/Supervisor reports to one Supervisor (or above).
  managerId String?
  manager   User?   @relation("Reports", fields: [managerId], references: [id], onDelete: SetNull)
  reports   User[]  @relation("Reports")

  sessions       Session[]
  projects       Project[]
  milestoneTasks MilestoneTask[] @relation("MilestoneTaskAuthor")
  soasCreated    Soa[]           @relation("SoaAuthor")

  // Service desk
  workflowSteps   WorkflowStepApprover[] @relation("StepActorOf")
  menuGrants      MenuGrant[]            @relation("MenuGrants")
  bouAccess       BouAccess[]            @relation("BouAccess")
  projectChanges  ProjectChange[]        @relation("ProjectChanges")
  candidates      Candidate[]            @relation("Recruiting")
  preJoVerified   PreJoDoc[]             @relation("PreJoVerifier")
  assessmentRuns  AssessmentRun[]        @relation("AssessmentRuns")
  invitesSent     CandidateInvite[]      @relation("InvitesSent")
  menuRenames     MenuLabel[]            @relation("MenuRenames")
  passwordResets  PasswordReset[]        @relation("PasswordResets")
  passwordHistory PasswordHistory[]      @relation("PasswordHistory")
  employee        Employee?              @relation("EmployeeAccount")
  ownedClients    Client[]               @relation("ClientOwner")
  ownedSuppliers  Supplier[]             @relation("SupplierOwner")
  ownedDeals      Deal[]                 @relation("DealOwner")
  requests        ServiceRequest[]       @relation("RequestedBy")
  approvalsGiven  RequestApproval[]      @relation("ApprovalsGiven")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Project {
  id          String  @id @default(cuid())
  name        String
  description String?
  /// Who the work is for. Free text for now — CRM clients may take over later.
  customer    String?

  /// When the work started, and when it finished. Closed is null while live.
  launchedAt DateTime?
  closedAt   DateTime?

  /// Planning, Active, On Hold, Closed, Cancelled.
  status   String @default("Planning")
  progress Int    @default(0) // 0–100

  /// Who owns it in the system — the account that created it.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Who runs it, and who covers when they cannot. Employees rather than
  /// accounts: the manager of a project is a person in the org chart, whether
  /// or not they ever sign in.
  managerId String?
  manager   Employee? @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)

  oicManagerId String?
  oicManager   Employee? @relation("ProjectOic", fields: [oicManagerId], references: [id], onDelete: SetNull)

  members    ProjectMember[]
  milestones Milestone[]
  roadblocks Roadblock[]
  risks      Risk[]
  changes    ProjectChange[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

/// A dated checkpoint on a project.
model Milestone {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name        String
  description String?
  dueDate     DateTime?
  completedAt DateTime?
  /// Pending, In Progress, Done, Missed.
  status      String    @default("Pending")

  /// Position in the run. Milestones are sequential, so the order is set by
  /// hand rather than inferred from dates — a checkpoint can be re-dated
  /// without silently jumping the queue.
  seq Int @default(0)

  /// Who is carrying it.
  ownerId String?
  owner   Employee? @relation("MilestoneOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  tasks MilestoneTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([projectId])
}

/// A unit of work under a milestone, added by the people carrying it.
/// Deliberately not the `Task` model — that one is the master list of step
/// names a workflow route picks from. This is real work on one project, and it
/// belongs to exactly one milestone.
model MilestoneTask {
  id          String    @id @default(cuid())
  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  name        String
  description String?
  startedAt   DateTime?
  closedAt    DateTime?
  /// Open or Closed. Simpler than its milestone on purpose — a task is either
  /// still being worked on or it is not.
  status      String    @default("Open")

  /// Who added it, so a task always traces back to a person.
  createdById String
  createdBy   User   @relation("MilestoneTaskAuthor", fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([milestoneId])
}

/// A statement of account for one employee — what they owe the company and
/// what the company owes them, as dated debit and credit lines.
model Soa {
  id  String @id @default(cuid())
  /// Human reference, e.g. SOA-2026-0001. What people quote to each other.
  ref String @unique

  /// One statement per employee — it is a running account, not a document
  /// reissued each period. Every debit and credit for that person lands here.
  employeeId String   @unique
  employee   Employee @relation("SoaEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  /// The employee's BOU when the statement was raised. Snapshotted, so a
  /// transfer does not silently re-file old statements.
  bouName String?

  periodFrom DateTime?
  periodTo   DateTime?
  /// Open or Closed.
  status     String    @default("Open")

  lines SoaLine[]

  createdById String
  createdBy   User   @relation("SoaAuthor", fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([employeeId])
}

/// One dated movement on a statement. A line is a debit or a credit, never
/// both — the other side stays zero rather than being left null.
model SoaLine {
  id    String @id @default(cuid())
  soaId String
  soa   Soa    @relation(fields: [soaId], references: [id], onDelete: Cascade)

  date        DateTime
  /// "Description" on the statement.
  particulars String
  /// Who asked for the spend. Free text — often someone with no account.
  requestor   String?
  /// "Charges" and "Credits" on the statement. A line is one or the other.
  debit       Decimal  @default(0) @db.Decimal(14, 2)
  credit      Decimal  @default(0) @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  @@index([soaId])
}

/// Something stopping the work now. A risk that has already happened.
model Roadblock {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  description String
  /// Low, Medium, High, Critical.
  severity    String    @default("Medium")
  /// Open, Escalated, Resolved.
  status      String    @default("Open")
  resolution  String?
  raisedAt    DateTime  @default(now())
  resolvedAt  DateTime?

  ownerId String?
  owner   Employee? @relation("RoadblockOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([projectId])
}

/// Something that might go wrong. Kept apart from Roadblock because a risk is
/// managed before it bites and a roadblock is already biting.
model Risk {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  description String
  /// Low, Medium, High.
  likelihood  String    @default("Medium")
  impact      String    @default("Medium")
  mitigation  String?
  /// Open, Mitigated, Accepted, Closed.
  status      String    @default("Open")
  closedAt    DateTime?

  ownerId String?
  owner   Employee? @relation("RiskOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([projectId])
}

/// One employee on one project. Carries the part they hold, so the same
/// person can be a lead on one project and a contributor on another.
model ProjectMember {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation("ProjectMemberships", fields: [employeeId], references: [id], onDelete: Cascade)

  /// Role held on this project — Lead, Member, Reviewer, Sponsor…
  holder String @default("Member")

  addedAt DateTime @default(now())

  @@unique([projectId, employeeId])
  @@index([employeeId])
}

/**
 * ======================================================== SERVICE DESK ====
 * Category -> Subcategory -> FormType. Choosing a category then a subcategory
 * in the Service Desk resolves to exactly one form and one approver chain.
 * Fields common to every request are columns on ServiceRequest; the per-form
 * additions are FormField rows, with their values stored in `details`.
 */

model RequestCategory {
  id        String  @id @default(cuid())
  name      String  @unique
  slug      String  @unique
  /// 3-digit code used in ticket references: YYMM-CCC-SSS-NNNN.
  code      Int     @unique @default(0)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  subcategories RequestSubcategory[]
}

model RequestSubcategory {
  id         String          @id @default(cuid())
  categoryId String
  category   RequestCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  slug       String
  /// 3-digit code, unique within its category.
  code       Int             @default(0)
  isActive   Boolean         @default(true)
  sortOrder  Int             @default(0)

  /// The form presented for this subcategory.
  formTypeId String
  formType   FormType @relation(fields: [formTypeId], references: [id])

  steps    WorkflowStep[]
  requests ServiceRequest[]

  @@unique([categoryId, slug])
  @@unique([categoryId, code])
}

/// An admin-built form definition. Reusable across subcategories.
model FormType {
  id       String  @id @default(cuid())
  name     String  @unique
  slug     String  @unique
  isActive Boolean @default(true)

  fields        FormField[]
  subcategories RequestSubcategory[]
}

enum FieldKind {
  TEXT
  TEXTAREA
  NUMBER
  CURRENCY
  DATE
  SELECT
  CHECKBOX
  FILE
  LOOKUP
}

/// One admin-defined input on a form. `key` is the property name used inside
/// ServiceRequest.details, so it is immutable once requests exist.
model FormField {
  id           String    @id @default(cuid())
  formTypeId   String
  formType     FormType  @relation(fields: [formTypeId], references: [id], onDelete: Cascade)
  key          String
  label        String
  kind         FieldKind @default(TEXT)
  required     Boolean   @default(false)
  helpText     String?
  sortOrder    Int       @default(0)
  /// Choices for SELECT fields, in display order. Empty for other kinds.
  options      String[]  @default([])
  /// For TABLE fields: which lookup table supplies the choices at runtime.
  optionSource String?
  /// Bounds for NUMBER / CURRENCY fields.
  minValue     Decimal?  @db.Decimal(14, 2)
  maxValue     Decimal?  @db.Decimal(14, 2)

  @@unique([formTypeId, key])
}

/// Who acts at a step.
enum StepActor {
  REQUESTOR
  APPROVER
}

/// One sequential step in a subtype's route, lowest sequence first.
model WorkflowStep {
  id            String             @id @default(cuid())
  subcategoryId String
  subcategory   RequestSubcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  sequence      Int
  /// Route status the ticket takes on at this step, e.g. Initiated, Assessed.
  name          String
  description   String?
  /// Service level in days for this step.
  slaDays       Int                @default(1)
  actor         StepActor          @default(APPROVER)
  /// Reserved — group-based assignment is not wired up yet.
  groupName     String?

  approvers WorkflowStepApprover[]

  @@unique([subcategoryId, sequence])
}

/// A step can require more than one named approver.
model WorkflowStepApprover {
  id     String       @id @default(cuid())
  stepId String
  step   WorkflowStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  userId String
  user   User         @relation("StepActorOf", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([stepId, userId])
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

model ServiceRequest {
  id            String             @id @default(cuid())
  /// Human-facing reference, e.g. SD-000142.
  reference     String             @unique
  /// Which company the ticket belongs to, stamped at creation from the
  /// requester. Held on the ticket rather than read through the requester so
  /// it survives someone moving company later — the ticket stays with the
  /// business that raised it.
  companyCode   String?
  requesterId   String
  requester     User               @relation("RequestedBy", fields: [requesterId], references: [id], onDelete: Cascade)
  subcategoryId String
  subcategory   RequestSubcategory @relation(fields: [subcategoryId], references: [id])

  // --- fields common to every service desk request ---
  subject     String
  description String?
  status      RequestStatus @default(DRAFT)

  /// Values for the form type's admin-defined fields, keyed by FormField.key.
  details Json @default("{}")

  /// Sequence of the approval step currently awaiting a decision.
  currentSequence Int       @default(1)
  submittedAt     DateTime?
  closedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  approvals RequestApproval[]

  @@index([requesterId, status])
  @@index([status])
  @@index([companyCode])
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

/// A snapshot of one step in a request's chain. Copied from WorkflowApprover at
/// submit time so later edits to the chain never rewrite decided history.
model RequestApproval {
  id         String           @id @default(cuid())
  requestId  String
  request    ServiceRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sequence   Int
  /// Route status copied from the step at submit time.
  stepName   String           @default("")
  actor      StepActor        @default(APPROVER)
  approverId String
  approver   User             @relation("ApprovalsGiven", fields: [approverId], references: [id], onDelete: Cascade)
  decision   ApprovalDecision @default(PENDING)
  remarks    String?
  decidedAt  DateTime?

  @@unique([requestId, sequence])
  @@index([approverId, decision])
}

/// Master list of task names used by workflows.
model Task {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

/// An explicit allow/deny for one navigation node, granted either to a role or
/// to a single user. Absence of a row means "fall back to the code default".
/// User grants beat role grants; role grants beat the default.
model MenuGrant {
  id      String  @id @default(cuid())
  /// "workflow" for a module, "workflow:routes" for a submenu.
  nodeKey String
  roleId  String?
  role    Role?   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  userId  String?
  user    User?   @relation("MenuGrants", fields: [userId], references: [id], onDelete: Cascade)
  allowed Boolean @default(true)

  @@unique([nodeKey, roleId])
  @@unique([nodeKey, userId])
  @@index([userId])
}

/**
 * ============================================================== HRIS ======
 * The person record. Deliberately separate from `User`: HR data is more
 * sensitive than a login row and has a different audience, so a breach or a
 * broad query against one must not expose the other. An employee may have no
 * account and an account need not be an employee — hence the nullable link.
 */
model Employee {
  id String @id @default(cuid())

  // --- identity, as supplied by the source system ---
  /// Primary key from the system this was imported from.
  rowid      Int     @unique
  /// The source system's own person identifier.
  individ    String  @unique
  lastName   String
  firstName  String
  middleName String?

  typeName  Int?
  roleName  String?
  company   String?
  jobTitle  String?
  emailAdd  String?
  birthDate DateTime?

  // --- contact ---
  street   String?
  city     String?
  state    String?
  /// Region of the chosen city, copied at save time.
  region   String?
  country  String  @default("Philippines")
  zipCode  String?
  language String?
  timeZone String?
  hobbies  String?
  landline String?
  mobile   String?
  fax      String?

  // --- source-system bookkeeping, kept verbatim ---
  status             Int?
  biometricID        String?
  accountType        Int?
  companyAccountCode String?
  isSenior           Boolean?
  isPWD              Boolean?
  lastmemo           String?
  bstdate            DateTime?
  departmentID       String?
  retailerName       String?
  department         String?
  emailAddref        String?
  bouID              String?
  encodedBy          String?
  sourceCreatedAt    DateTime?
  sourceUpdatedAt    DateTime?

  // --- fields captured by the HRIS form ---
  /// The BOU this employee belongs to.
  bouId            String?
  bou              Bou?      @relation(fields: [bouId], references: [id], onDelete: SetNull)
  /// Sub-BOU or department under the BOU.
  subBou           String?
  gender           String?
  mobile2          String?
  startDate        DateTime?
  /// Term-Based, Probationary, Regular…
  empStatus        String?
  /// Rank & File, Supervisory, Managerial…
  empType          String?
  endOfContract    DateTime?
  lastWorkingDate  DateTime?
  terminationDate  DateTime?
  /// Active, Resigned, Terminated…
  employmentStatus String    @default("Active")
  remarks          String?
  // --- statutory identifiers (Philippines) ---
  compId           String?
  tinId            String?
  sssId            String?
  philId           String?
  pagibigId        String?
  hmoId            String?

  /// Can sign in to systems / may file expenses.
  hasAccess  Boolean @default(false)
  hasExpense Boolean @default(false)

  /// Set when this employee was hired through Recruitment.
  candidate Candidate? @relation("HiredFrom")

  /// Work assigned to this person under PROJECT.
  projects        ProjectMember[] @relation("ProjectMemberships")
  managesProjects Project[]       @relation("ProjectManager")
  oicProjects     Project[]       @relation("ProjectOic")
  milestonesOwned Milestone[]     @relation("MilestoneOwner")
  soa             Soa?            @relation("SoaEmployee")
  roadblocksOwned Roadblock[]     @relation("RoadblockOwner")
  risksOwned      Risk[]          @relation("RiskOwner")

  /// Optional link to a login account. Null for staff with no access.
  userId String? @unique
  user   User?   @relation("EmployeeAccount", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([lastName, firstName])
  @@index([company])
}

/// A company the business operates as. Employees and accounts belong to one.
model Company {
  id        String  @id @default(cuid())
  /// Short code shared with Employee.company, e.g. ATO01-165846.
  code      String  @unique
  name      String
  tin       String?
  address   String?
  pocEmail  String?
  /// Brand mark as a data URL, shown on documents the company sends out.
  /// Held inline rather than in object storage — one small image per company,
  /// and it must be there when a statement renders.
  logo      String?
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

/**
 * ================================================================ CRM =====
 * Client -> Contact -> Deal. A client is an organisation we sell to, contacts
 * are the people there, and deals are the opportunities moving through stages.
 */

enum DealStage {
  NEW
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

/// A company we buy from. Kept apart from Client: a supplier is the other
/// side of the relationship, with its own terms and contacts.
model Supplier {
  id       String  @id @default(cuid())
  name     String  @unique
  category String?
  /// What they supply, in a sentence.
  supplies String?

  contactName  String?
  contactEmail String?
  phone        String?
  website      String?

  address String?
  city    String?
  country String?

  /// Registration and payment details.
  tin          String?
  paymentTerms String?

  notes    String?
  isActive Boolean @default(true)

  /// Who owns the relationship.
  ownerId String?
  owner   User?   @relation("SupplierOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([name])
}

model Client {
  id       String  @id @default(cuid())
  name     String  @unique
  industry String?
  website  String?
  phone    String?
  city     String?
  country  String?
  notes    String?
  isActive Boolean @default(true)

  /// Who owns the relationship.
  ownerId String?
  owner   User?   @relation("ClientOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  contacts Contact[]
  deals    Deal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([name])
}

model Contact {
  id        String  @id @default(cuid())
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  title     String?
  email     String?
  mobile    String?
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([clientId])
}

model Deal {
  id                String    @id @default(cuid())
  clientId          String
  client            Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title             String
  amount            Decimal?  @db.Decimal(14, 2)
  currency          String    @default("PHP")
  stage             DealStage @default(NEW)
  /// 0–100, the owner's own read on likelihood.
  probability       Int?
  expectedCloseDate DateTime?
  notes             String?

  ownerId String?
  owner   User?   @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  /// Position within its stage column, lowest first.
  sortOrder Int       @default(0)
  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@index([stage])
  @@index([clientId])
}

/// Rotatable configuration. A value here overrides the matching env var, so
/// keys can be changed from the UI without a redeploy — same as benta.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

/// Outbox: every notification is recorded whether or not it was really sent.
model Notification {
  id      String @id @default(cuid())
  channel String // email
  to      String
  subject String
  body    String
  /// What triggered it: ticket_submitted | step_awaiting | ticket_decided | registration
  kind    String

  /// Which transport actually carried it — mailgun | smtp | null when log-only.
  provider   String?
  providerId String?
  status     String    @default("queued") // queued | sent | failed
  sentAt     DateTime?
  failedAt   DateTime?
  failReason String?

  /// The ticket this concerns, when it concerns one.
  requestId String?

  createdAt DateTime @default(now())

  @@index([kind, createdAt])
  @@index([requestId])
}

/**
 * Editable metadata for each role. The Role enum stays the security primitive
 * — it is referenced by User, MenuGrant and every permission check — while
 * this table carries what the owner can safely change: the name shown, a
 * description, ordering, and whether it may still be assigned.
 */
model Role {
  id          String  @id @default(cuid())
  /// Stable machine key the permission checks compare against.
  key         String  @unique
  label       String
  description String?
  /// Higher outranks lower; mirrors the ranking used by the permission checks.
  rank        Int     @default(0)
  /// Deactivated roles cannot be assigned to anyone new.
  isActive    Boolean @default(true)
  /// Built in: cannot be deleted, only renamed or deactivated.
  isSystem    Boolean @default(true)

  users  User[]
  grants MenuGrant[]

  updatedAt DateTime @default(now()) @updatedAt
}

/// Business Operating Unit. Employees belong to one; it is the grouping the
/// HRIS reports on, kept as its own table so the name can change without
/// touching every employee record.
model Bou {
  id           String  @id @default(cuid())
  /// Source system's row id.
  rowId        Int     @unique
  /// Stable code, e.g. B2020-00001.
  code         String  @unique
  name         String
  /// Company code this BOU sits under; matches Company.code.
  companyCode  String
  /// The fallback BOU when none is chosen.
  isDefault    Boolean @default(false)
  managerName  String?
  managerEmail String?
  isActive     Boolean @default(true)

  employees  Employee[]
  candidates Candidate[]
  bouAccess  BouAccess[] @relation("BouAccess")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([companyCode])
  @@index([name])
}

/// Audit trail of notable transactions. createdByName is a snapshot so the
/// entry survives even if the acting user is later removed.
model LogHistory {
  id            String   @id @default(cuid())
  /// Transaction type: create | update | delete | approve | reject | login…
  type          String
  /// Menu or submenu being touched, e.g. "Settings > Users".
  module        String   @default("")
  description   String
  createdById   String?
  createdByName String   @default("System")
  /// The actor's BOU at the time, snapshotted alongside their name. Resolving
  /// it live would rewrite history every time someone transfers.
  createdByBou  String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([module])
}

/// Cities employees can be based in, with the province and region they sit in
/// so choosing a city settles the region rather than asking twice.
/// Someone applying for a role. Kept apart from Employee: a candidate is not
/// staff, and most never become staff. Hiring links the two rather than
/// copying one into the other.
model Candidate {
  id String @id @default(cuid())

  firstName  String
  lastName   String
  middleName String?
  email      String?
  mobile     String?

  /// Role applied for, and where the application came from.
  position String?
  source   String?

  /// The CV itself. Held in the database rather than object storage: it needs
  /// no extra credentials, and a CV is a few hundred kilobytes.
  cvData     Bytes?
  cvFileName String?
  cvMime     String?
  cvSize     Int?

  // --- read off the CV ---
  summary         String?
  skills          String[]
  yearsExperience Int?
  education       String?
  currentEmployer String?
  location        String?
  /// When the CV was last read, so a re-read can be told from a manual edit.
  parsedAt        DateTime?
  /// Everything the reader returned, including anything with no field of its
  /// own. Kept so a useful value is not thrown away before it has a column.
  aiData          Json?
  /// The assessment, when it has been run. Held whole so the tab renders it
  /// without a second call, and so a re-run can be compared against the last.
  assessment      Json?
  assessedAt      DateTime?
  /// Input + output tokens of the last run, so the cost is visible.
  assessTokens    Int?

  /// A recruiter's own notes against the AI findings — kept apart from the
  /// general notes so a judgement is never mistaken for something the CV said.
  aiNotes String?

  // --- money ---
  /// What they are on now and what they want, as figures rather than a note,
  /// so a shortlist can be compared. Monthly PHP unless a period says otherwise.
  currentSalary  Decimal? @db.Decimal(12, 2)
  expectedSalary Decimal? @db.Decimal(12, 2)
  offeredSalary  Decimal? @db.Decimal(12, 2)
  salaryPeriod   String   @default("Monthly")
  salaryCurrency String   @default("PHP")
  /// Allowances, bonus structure, notice period, anything that changes the
  /// real number.
  salaryNotes    String?

  /// Applied, Screening, Interview, Offer, Hired, Rejected, Withdrawn.
  stage  String  @default("Applied")
  rating Int?
  notes  String?

  /// Which part of the business is hiring.
  bouId       String?
  bou         Bou?    @relation(fields: [bouId], references: [id], onDelete: SetNull)
  companyCode String?

  /// Who is handling the application.
  recruiterId String?
  recruiter   User?   @relation("Recruiting", fields: [recruiterId], references: [id], onDelete: SetNull)

  experience  WorkExperience[]
  references  CharacterReference[]
  preJoDocs   PreJoDoc[]
  assessments AssessmentRun[]
  verifyItems VerifyItem[]
  invites     CandidateInvite[]

  /// Set when the candidate is hired and becomes staff.
  employeeId String?   @unique
  employee   Employee? @relation("HiredFrom", fields: [employeeId], references: [id], onDelete: SetNull)
  hiredAt    DateTime?

  appliedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([stage])
  @@index([lastName, firstName])
}

/// Which BOUs one user may see records for. Menu access says which *pages* a
/// user can open; this says which *records* they may see once there.
/// No rows for a user means unscoped — the pages they can open show everything.
model BouAccess {
  id String @id @default(cuid())

  userId String
  user   User   @relation("BouAccess", fields: [userId], references: [id], onDelete: Cascade)

  bouId String
  bou   Bou    @relation("BouAccess", fields: [bouId], references: [id], onDelete: Cascade)

  grantedAt DateTime @default(now())

  @@unique([userId, bouId])
  @@index([userId])
}

/// One field changed on a project: what it was, what it became, who did it.
/// Written in the same transaction as the update, so a saved change can never
/// exist without its trail.
model ProjectChange {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// What was touched — the project itself, or a milestone/roadblock/risk.
  entity     String  @default("Project")
  entityId   String?
  /// A readable name for the thing changed, kept even if the row is deleted.
  entityName String?

  /// Field label as a person reads it, e.g. "Date launched".
  field    String
  oldValue String?
  newValue String?

  /// create | update | delete — an add has no old value, a delete no new one.
  action String @default("update")

  actorId   String?
  actor     User?    @relation("ProjectChanges", fields: [actorId], references: [id], onDelete: SetNull)
  actorName String   @default("System")
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

/// One post held by a candidate. Rows rather than free text, so they can be
/// sorted, counted and searched — a CV's employment history is structured.
model WorkExperience {
  id String @id @default(cuid())

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  /// Years only. A CV rarely gives months, and "to" is blank while current.
  yearFrom Int?
  yearTo   Int?

  companyName String
  position    String?
  city        String?
  country     String?

  /// What they actually did.
  duties String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([candidateId])
}

/// A character reference given by a candidate. Rows rather than free text so
/// a recruiter can record who was called and what came back.
model CharacterReference {
  id String @id @default(cuid())

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  name         String
  relationship String?
  company      String?
  position     String?
  contactNo    String?
  email        String?

  /// What the reference said, and when they were reached.
  remarks     String?
  contactedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([candidateId])
}

/// A pre-employment document the candidate submits before a job offer.
/// Recorded, never looked up: NBI, barangay and police clearances are issued
/// to the person, so the candidate hands them over.
model PreJoDoc {
  id String @id @default(cuid())

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  /// NBI Clearance, Barangay Clearance, Police Clearance, Medical…
  docType String
  /// Clearance or certificate number as printed.
  refNo   String?
  issuer  String?

  issuedAt  DateTime?
  expiresAt DateTime?

  /// Pending, Submitted, Verified, Rejected, Not Required.
  status  String  @default("Pending")
  remarks String?

  /// The document itself, held in the database like a CV.
  fileData Bytes?
  fileName String?
  fileMime String?
  fileSize Int?

  verifiedById String?
  verifiedBy   User?     @relation("PreJoVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([candidateId])
}

/// Every assessment ever run on a candidate, kept whole.
///
/// The candidate carries the latest for quick rendering; this is the record of
/// what was actually produced, when, against which role and by whom. An
/// assessment informs a hiring decision, so it should not be silently replaced
/// by the next run.
model AssessmentRun {
  id String @id @default(cuid())

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  /// The role it was assessed against — the same CV reads differently for a
  /// different post, so the question is part of the answer.
  role   String
  result Json

  model        String?
  inputTokens  Int?
  outputTokens Int?

  runById   String?
  runBy     User?   @relation("AssessmentRuns", fields: [runById], references: [id], onDelete: SetNull)
  runByName String  @default("")

  createdAt DateTime @default(now())

  @@index([candidateId, createdAt])
}

/// One "verify this" item from an assessment, with what the recruiter and the
/// hiring manager found. Rows rather than a note, so an item cannot be quietly
/// dropped and each is answered by the person accountable for it.
model VerifyItem {
  id String @id @default(cuid())

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  /// "verify" — a claim to check; "question" — one to ask at interview.
  kind String @default("verify")

  /// The claim or question, as the assessment worded it.
  item String

  recruiterRemarks String?
  managerRemarks   String?

  /// The candidate's own answer, given through the invite link. Kept apart
  /// from the two internal remark fields — it is their words, not a note about
  /// them, and it must never be editable from the recruiter side.
  candidateAnswer String?
  answeredAt      DateTime?

  /// Open, Verified, Discrepancy, Cannot Verify, Not Applicable.
  status String @default("Open")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([candidateId, kind, item])
  @@index([candidateId])
}

/// A link sent to a candidate so they can answer the interview questions in
/// their own words.
///
/// The token is the only credential, so it is long and random and the page it
/// opens shows the questions and nothing else — never the assessment, the
/// risks, or anything a recruiter wrote.
model CandidateInvite {
  id String @id @default(cuid())

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  /// What the URL carries. Unguessable, and not derived from any record id.
  token String @unique

  /// A note to the candidate, shown above the questions.
  message String?

  expiresAt   DateTime
  openedAt    DateTime?
  submittedAt DateTime?
  /// Set when a recruiter withdraws the link before it is used.
  revokedAt   DateTime?

  createdById String?
  createdBy   User?   @relation("InvitesSent", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([candidateId])
}

/// A renamed menu. The nav is declared in code; this overrides what it is
/// called, so spelling and case can be fixed without a deploy.
///
/// Keyed the same way access is — "hris" for a module, "hris:employees" for a
/// page — so the two always talk about the same thing.
model MenuLabel {
  id String @id @default(cuid())

  nodeKey String  @unique
  label   String
  /// Spelt-out name shown on hover, for abbreviations like COA.
  title   String?

  updatedById String?
  updatedBy   User?    @relation("MenuRenames", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @default(now()) @updatedAt
}

model City {
  id       String  @id @default(cuid())
  name     String  @unique
  province String?
  region   String?
  /// Primary postal code. Large cities have several; this is the main one.
  zipCode  String?
  country  String  @default("Philippines")
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([region])
}

/// Reusable marketing email templates. Each carries a default subject, body
/// and signature the send form can load.
model EmailTemplate {
  id            String   @id @default(cuid())
  name          String   @unique
  subject       String   @default("")
  body          String   @default("")
  signature     String   @default("")
  createdById   String?
  createdByName String   @default("System")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  recipients EmailTemplateRecipient[]

  @@index([name])
}

/// Per-recipient send log for a template, so we can tell whether an address
/// already received this one and skip it rather than pestering them twice.
model EmailTemplateRecipient {
  id         String        @id @default(cuid())
  templateId String
  template   EmailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  email      String
  sentAt     DateTime      @default(now())

  @@unique([templateId, email])
  @@index([templateId])
}

/// Unsubscribe list — addresses here are skipped by every campaign.
model Suppression {
  email     String   @id
  reason    String?
  createdAt DateTime @default(now())
}

/// A one-time code emailed before a password may be reset. The code itself is
/// never stored — only a bcrypt hash — so a database leak cannot be replayed.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("PasswordResets", fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  /// Wrong guesses. The code dies after a handful.
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Hashes of passwords already used on an account, so an old one cannot be
/// brought back. Only hashes are kept — never the passwords themselves.
model PasswordHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("PasswordHistory", fields: [userId], references: [id], onDelete: Cascade)
  hash      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
