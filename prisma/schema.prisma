// Argonaut — Prisma schema. Postgres on Supabase (DATABASE_URL, pooled).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String // bcrypt
  createdAt    DateTime  @default(now())

  sessions Session[]
  projects Project[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Project {
  id        String   @id @default(cuid())
  name      String
  status    String   @default("Draft") // Draft | In progress | Shared
  progress  Int      @default(0) // 0–100
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
